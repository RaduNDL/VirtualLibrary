@page "{id:int}"
@model VirtualLibrary.Pages.MyBooks.ReadBookModel
@{
    ViewData["Title"] = $"Read: {Model.Product.Title}";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/ReadPdf.css">

<div class="reader-wrapper">
    <header class="reader-header">
        <a asp-page="/MyBooks/Index" class="back-link">
            <i class='bx bx-left-arrow-alt'></i> Back to My Books
        </a>

        <h2><i class='bx bxs-file-pdf'></i> @Model.Product.Title</h2>

        @if (!string.IsNullOrWhiteSpace(Model.Product.Author))
        {
            <span class="author-sub">by @Model.Product.Author</span>
        }
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-info mb-3">
            @Html.Raw(Model.StatusMessage)
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.PdfUrl))
    {
        <div class="pdf-viewer-container">
            <iframe src="@Model.PdfUrl"
                    class="pdf-iframe"
                    title="@Model.Product.Title"
                    allowfullscreen>
                <p>
                    Your browser does not support inline PDFs.
                    <a href="@Model.PdfUrl" target="_blank">Open the PDF</a>.
                </p>
            </iframe>
        </div>

        <div class="pdf-actions-bar">
            <a href="@Model.PdfUrl" download class="btn-download">
                <i class='bx bx-download'></i> Download PDF
            </a>

            <a href="@Model.PdfUrl" target="_blank" class="btn-fullscreen">
                <i class='bx bx-fullscreen'></i> Open in New Tab
            </a>

            @if (!string.IsNullOrWhiteSpace(Model.Product.DescriptionPdfPath))
            {
                <a asp-page="/Products/DescriptionPdf"
                   asp-route-id="@Model.Product.Id"
                   class="btn-fullscreen">
                    <i class='bx bx-detail'></i> Details PDF
                </a>
            }

            <form method="post" asp-page-handler="GenerateAudio" class="d-inline">
                <button type="submit"
                        class="btn-fullscreen"
                        style="background:#6f42c1; border:none; cursor:pointer; color:#fff;">
                    <i class='bx bx-headphone'></i>
                    @(Model.Audiobook?.Status == VirtualLibrary.Models.AudiobookStatus.Completed
                                    ? "Regenerate Audiobook"
                                    : "Generate Audiobook")
                </button>
            </form>
        </div>
    }
    else
    {
        <div class="no-pdf-box">
            <i class='bx bx-error-circle'></i>
            <h3>PDF Not Available</h3>
            <p>This book does not have an attached book PDF yet.</p>

            <div class="d-flex justify-content-center gap-2 mt-3 flex-wrap">
                @if (!string.IsNullOrWhiteSpace(Model.Product.DescriptionPdfPath))
                {
                    <a asp-page="/Products/DescriptionPdf"
                       asp-route-id="@Model.Product.Id"
                       class="btn-back">
                        View Details PDF
                    </a>
                }

                <form method="post" asp-page-handler="GenerateAudio" class="d-inline">
                    <button type="submit"
                            class="btn-back"
                            style="border:none;">
                        Generate Audiobook
                    </button>
                </form>
            </div>
        </div>
    }

    @if (Model.Audiobook?.Status == VirtualLibrary.Models.AudiobookStatus.Completed && !string.IsNullOrWhiteSpace(Model.AudioSourceUrl))
    {
        <div class="mt-3" style="width:100%; background:#fff; padding:15px; border-radius:10px; border:1px solid #dee2e6;">
            <h5 style="margin-bottom:10px;">
                <i class='bx bx-volume-full'></i> Audiobook Player
            </h5>

            <audio controls style="width:100%;" src="@Model.AudioSourceUrl">
                Your browser does not support the audio element.
            </audio>
        </div>
    }
</div>