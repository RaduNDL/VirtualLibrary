@page
@model VirtualLibrary.Pages.Search.SpecificationsModel
@{
    ViewData["Title"] = "Specifications Search";
    Layout = "~/Pages/Shared/_Layout.cshtml";

    var currentReturnUrl = $"{Request.Path}{Request.QueryString}";
}

<link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
<link href="~/css/specifications.css" rel="stylesheet">

    <div class="container vt-main-container mt-4 mb-5">
    
        <div class="vt-search-panel mb-5 p-4 rounded-4 shadow-sm border border-light">
            <div class="row align-items-center mb-4">
                <div class="col-lg-12">
                    <h1 class="display-5 fw-bold vt-title text-primary mb-2">Advanced Search</h1>
                    <p class="lead text-muted vt-subtitle mb-0">
                        Full-text search in specification PDFs using <span class="badge bg-light text-primary fw-medium border">Apache Lucene</span>.
                    </p>
                </div>
            </div>

            <form method="get" class="vt-search-form" id="searchForm">
                <div class="row g-3 align-items-end">
                    <div class="col-md-7 col-lg-8">
                        <div class="input-group input-group-lg vt-input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class='bx bx-search vt-input-group-icon'></i>
                            </span>
                            <input type="text"
                                   name="q"
                                   id="searchInputGroup"
                                   value="@Model.q"
                                   class="form-control vt-form-input border-start-0 ps-0"
                                   placeholder="Search phrase or query..." />
                        </div>
                    </div>

                    <div class="col-md-5 col-lg-4">
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-8 col-md-7">
                                <label class="form-label text-muted fw-semibold mb-1 small" for="sortSelect">Sort by score</label>
                                <select name="sort" id="sortSelect" class="form-select vt-form-select">
                                    <option value="score_desc" selected="@(Model.sort == "score_desc" ? "selected" : null)">Score descending</option>
                                    <option value="score_asc" selected="@(Model.sort == "score_asc" ? "selected" : null)">Score ascending</option>
                                </select>
                            </div>
                            <div class="col-sm-4 col-md-5 d-grid">
                                <button type="submit" class="btn btn-primary vt-search-btn" id="searchButton">
                                    <i class='bx bx-search vt-btn-icon'></i>
                                    <span>Search</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        @if (string.IsNullOrWhiteSpace(Model.q))
        {
            <div class="vt-no-results-panel p-5 text-center bg-light border border-light rounded-4 shadow-sm">
                <i class='bx bxs-keyboard display-1 text-secondary opacity-50 mb-4'></i>
                <p class="lead text-muted mb-0">Start searching through specification PDFs to find relevant documents.</p>
            </div>
        }
        else if (!Model.Results.Any())
        {
            <div class="vt-no-results-panel p-5 text-center bg-light border border-light rounded-4 shadow-sm">
                <i class='bx bx-search-alt display-1 text-danger opacity-50 mb-4'></i>
                <h3 class="fw-bold text-dark">No results found</h3>
                <p class="lead text-muted mb-0">We couldn't find any documents matching '<strong>@Model.q</strong>'. Try a different phrase.</p>
            </div>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center mb-4 vt-results-header">
                <h5 class="mb-0 fw-bold vt-results-count text-primary">
                    <i class='bx bxs-file-find me-2'></i>
                    <span>Found</span> @Model.Results.Count result(s)
                </h5>
                <span class="vt-query-badge badge bg-primary text-white p-2 px-3 fw-medium">
                    Query: <strong>@Model.q</strong>
                </span>
            </div>

            <div class="vt-results-list">
                @foreach (var item in Model.Results)
                {
                    <div class="vt-result-item mb-4">
                        <div class="card vt-result-card border-0 shadow-sm p-3 rounded-4">
                            <div class="card-body d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-4">
                            
                                <div class="vt-result-details">
                                    <h4 class="fw-extrabold vt-result-title text-dark mb-1">@item.Title</h4>

                                    @if (!string.IsNullOrWhiteSpace(item.Author))
                                    {
                                        <p class="text-muted vt-result-author mb-3 fw-medium">by @item.Author</p>
                                    }

                                    <div class="vt-action-buttons d-flex flex-wrap gap-2 mt-3">
                                        <a asp-page="/Products/Details"
                                               asp-route-id="@item.ProductId"
                                               asp-route-returnUrl="@currentReturnUrl"
                                               class="btn btn-primary vt-btn-premium">
                                            <i class='bx bxs-chevron-right-square me-1'></i> View product
                                        </a>

                                        @if (!string.IsNullOrWhiteSpace(item.PdfPath))
                                        {
                                            <a href="~/@item.PdfPath"
                                                   target="_blank"
                                                   class="btn btn-outline-secondary vt-btn-premium-outline">
                                                <i class='bx bxs-file-pdf me-1'></i> Open PDF
                                            </a>
                                        }
                                    </div>
                                </div>

                                <div class="text-lg-end vt-score-section">
                                    <div class="vt-score-badge p-4 bg-light border-0 rounded-4 shadow-sm d-flex flex-column align-items-center justify-content-center">
                                        <div class="text-muted small fw-semibold text-uppercase vt-score-label mb-1">
                                            <i class='bx bxs-trophy me-1'></i> Lucene score
                                        </div>
                                        <div class="fw-extrabold display-5 vt-score-value text-primary">
                                            @item.Score.ToString("0.0000")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @section Scripts {
        <script src="~/js/specifications.js"></script>
    }