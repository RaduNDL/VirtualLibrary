@page "{id:int}"
@model VirtualLibrary.Pages.Products.DescriptionPdfModel
@{
    ViewData["Title"] = $"Details PDF - {Model.Product.Title}";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/ReadPdf.css">

<div class="reader-wrapper">
    <header class="reader-header">
        <a asp-page="./Details" asp-route-id="@Model.Product.Id" class="back-link">
            <i class='bx bx-left-arrow-alt'></i> Back to Book
        </a>

        <h2>
            <i class='bx bxs-file-pdf'></i> Details PDF - @Model.Product.Title
        </h2>

        @if (!string.IsNullOrWhiteSpace(Model.Product.Author))
        {
            <span class="author-sub">by @Model.Product.Author</span>
        }
    </header>

    <div class="row g-3 mb-3">
        <div class="col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Book Details</h5>

                    <p class="mb-2"><strong>Title:</strong> @Model.Product.Title</p>

                    @if (!string.IsNullOrWhiteSpace(Model.Product.Author))
                    {
                        <p class="mb-2"><strong>Author:</strong> @Model.Product.Author</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Product.Category?.Name))
                    {
                        <p class="mb-2"><strong>Category:</strong> @Model.Product.Category.Name</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Product.Publisher))
                    {
                        <p class="mb-2"><strong>Publisher:</strong> @Model.Product.Publisher</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Product.Isbn))
                    {
                        <p class="mb-2"><strong>ISBN:</strong> @Model.Product.Isbn</p>
                    }

                    @if (Model.Product.PublishedYear.HasValue)
                    {
                        <p class="mb-2"><strong>Published Year:</strong> @Model.Product.PublishedYear.Value</p>
                    }

                    @if (Model.Product.PageCount.HasValue)
                    {
                        <p class="mb-2"><strong>Page Count:</strong> @Model.Product.PageCount.Value</p>
                    }

                    <p class="mb-0"><strong>Price:</strong> @Model.Product.Price.ToString("0.00") RON</p>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="pdf-viewer-container">
                <iframe src="@Model.PdfUrl"
                        class="pdf-iframe"
                        title="Details PDF for @Model.Product.Title"
                        allowfullscreen>
                    <p>
                        Your browser does not support inline PDFs.
                        <a href="@Model.PdfUrl" target="_blank">Open PDF</a>.
                    </p>
                </iframe>
            </div>

            <div class="pdf-actions-bar mt-3">
                <a href="@Model.PdfUrl" download class="btn-download">
                    <i class='bx bx-download'></i> Download PDF
                </a>

                <a href="@Model.PdfUrl" target="_blank" class="btn-fullscreen">
                    <i class='bx bx-fullscreen'></i> Open in New Tab
                </a>

                @if (!string.IsNullOrWhiteSpace(Model.Product.PdfFilePath))
                {
                    <a asp-page="./ReadPdf"
                       asp-route-id="@Model.Product.Id"
                       class="btn-fullscreen">
                        <i class='bx bx-book-open'></i> Open Book PDF
                    </a>
                }
            </div>
        </div>
    </div>
</div>