@page "{id:int}"
@model VirtualLibrary.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "Delete Book";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <h2 class="text-danger mb-4">
        Delete Book
    </h2>

    <div class="card shadow-sm">

        <div class="card-body">

            <h4 class="text-danger">
                Are you sure you want to delete this book?
            </h4>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">
                    Title
                </dt>

                <dd class="col-sm-9">
                    @Model.Product.Title
                </dd>


                <dt class="col-sm-3">
                    Author
                </dt>

                <dd class="col-sm-9">
                    @Model.Product.Author
                </dd>


                <dt class="col-sm-3">
                    ISBN
                </dt>

                <dd class="col-sm-9">
                    @Model.Product.Isbn
                </dd>


                <dt class="col-sm-3">
                    Publisher
                </dt>

                <dd class="col-sm-9">
                    @Model.Product.Publisher
                </dd>


                <dt class="col-sm-3">
                    Category
                </dt>

                <dd class="col-sm-9">
                    @Model.Product.Category?.Name
                </dd>


                <dt class="col-sm-3">
                    Price
                </dt>

                <dd class="col-sm-9">
                    @Model.Product.Price.ToString("0.00") RON
                </dd>

            </dl>

            <form method="post">

                <input type="hidden" asp-for="Product.Id" />

                <button type="submit"
                        class="btn btn-danger">

                    Delete

                </button>

                <a asp-page="./Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>