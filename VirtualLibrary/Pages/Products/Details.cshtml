@page "{id:int}"
@model VirtualLibrary.Pages.Products.DetailsModel
@{
    ViewData["Title"] = Model.Product.Title;
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/ProductDetails.css" asp-append-version="true" />

<div class="container mt-4 mb-5">
    <div class="mb-3">
        <a href="@Model.SafeReturnUrl" class="btn btn-outline-secondary">
            <i class='bx bx-left-arrow-alt'></i> Back
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    @if (!string.IsNullOrWhiteSpace(Model.Product.ImagePath))
                    {
                        <img src="~/@Model.Product.ImagePath"
                             class="img-fluid rounded shadow"
                             alt="@Model.Product.Title"
                             onerror="this.src='/images/no-cover.svg';this.onerror=null;" />
                    }
                    else
                    {
                        <img src="~/images/no-cover.svg"
                             class="img-fluid rounded shadow"
                             alt="No cover available" />
                    }

                    <div class="mt-3">
                        <span class="badge bg-primary fs-6">@Model.Product.Price.ToString("0.00") RON</span>
                    </div>

                    @if (Model.HasDescriptionPdf)
                    {
                        <div class="mt-3 d-grid gap-2">
                            <a asp-page="./DescriptionPdf" asp-route-id="@Model.Product.Id" class="btn btn-danger">
                                <i class='bx bxs-file-pdf'></i> Open Details PDF
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @if (!string.IsNullOrWhiteSpace(Model.Product.Category?.Name))
                        {
                            <span class="badge bg-secondary">@Model.Product.Category.Name</span>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Product.Supplier?.Name))
                        {
                            <span class="badge bg-light text-dark border">@Model.Product.Supplier.Name</span>
                        }

                        @if (Model.HasDescriptionPdf)
                        {
                            <span class="badge bg-success">Indexed PDF Available</span>
                        }
                    </div>

                    <h1 class="fw-bold mb-2">@Model.Product.Title</h1>

                    @if (!string.IsNullOrWhiteSpace(Model.Product.Author))
                    {
                        <p class="text-muted fs-5 mb-4">by @Model.Product.Author</p>
                    }

                    <h5 class="fw-bold mb-3">Description</h5>
                    <p class="mb-0" style="white-space: pre-line;">
                        @(string.IsNullOrWhiteSpace(Model.Product.Description)
                            ? "No description available."
                            : Model.Product.Description)
                    </p>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Book Details</h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div><strong>Title:</strong> @Model.Product.Title</div>
                        </div>

                        <div class="col-md-6">
                            <div><strong>Author:</strong> @(Model.Product.Author ?? "-")</div>
                        </div>

                        <div class="col-md-6">
                            <div><strong>ISBN:</strong> @(Model.Product.Isbn ?? "-")</div>
                        </div>

                        <div class="col-md-6">
                            <div><strong>Publisher:</strong> @(Model.Product.Publisher ?? "-")</div>
                        </div>

                        <div class="col-md-6">
                            <div><strong>Published Year:</strong> @(Model.Product.PublishedYear?.ToString() ?? "-")</div>
                        </div>

                        <div class="col-md-6">
                            <div><strong>Page Count:</strong> @(Model.Product.PageCount?.ToString() ?? "-")</div>
                        </div>

                        <div class="col-md-6">
                            <div><strong>Language:</strong> @(Model.Product.Language ?? "-")</div>
                        </div>

                        <div class="col-md-6">
                            <div><strong>Rating:</strong> @(Model.Product.Rating?.ToString("0.0") ?? "-")</div>
                        </div>

                        <div class="col-md-6">
                            <div><strong>Category:</strong> @(Model.Product.Category?.Name ?? "-")</div>
                        </div>

                        <div class="col-md-6">
                            <div><strong>Supplier:</strong> @(Model.Product.Supplier?.Name ?? "-")</div>
                        </div>

                        <div class="col-md-6">
                            <div><strong>Price:</strong> @Model.Product.Price.ToString("0.00") RON</div>
                        </div>

                        <div class="col-md-6">
                            <div><strong>Created At:</strong> @Model.Product.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC</div>
                        </div>

                        <div class="col-md-6">
                            <div><strong>Updated At:</strong> @(Model.Product.UpdatedAtUtc?.ToString("dd.MM.yyyy HH:mm 'UTC'") ?? "-")</div>
                        </div>

                        <div class="col-md-6">
                            <div><strong>Details PDF:</strong> @(Model.HasDescriptionPdf ? "Yes" : "No")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>