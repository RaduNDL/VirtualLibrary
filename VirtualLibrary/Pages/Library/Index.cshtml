@page
@model VirtualLibrary.Pages.Library.IndexModel
@{
    ViewData["Title"] = "Library";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/Library.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/LibraryAutocomplete.css" asp-append-version="true" />

<div class="library-wrapper">
    <div class="library-container">
        <div class="library-header">
            <div class="header-left">
                <h2>Available Book Records</h2>

                @if (Model.Products.Any())
                {
                    <span class="badge-count">@Model.Products.Count record(s) found</span>
                }
            </div>

            <div class="header-right d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-2">
                <form method="get" class="search-form" autocomplete="off">
                    <div class="search-autocomplete-wrapper">
                        <div class="search-bar">
                            <i class='bx bx-search'></i>
                            <input type="text"
                                   id="librarySearchInput"
                                   name="q"
                                   value="@Model.q"
                                   placeholder="Search by title, author, ISBN..."
                                   aria-label="Search books" />
                            <button type="submit">Search</button>
                        </div>

                        <div id="libraryAutocompleteBox" class="autocomplete-box"></div>
                    </div>
                </form>

                <a asp-page="/Search/Specifications" class="btn btn-outline-primary">
                    <i class='bx bx-file-find'></i> Search PDFs
                </a>
            </div>
        </div>
        @if (!Model.Products.Any())
        {
            <div class="empty-state">
                <i class='bx bx-search-alt-2'></i>

                @if (!string.IsNullOrWhiteSpace(Model.q))
                {
                    <h3>No records match "@Model.q"</h3>
                    <a asp-page="/Library/Index" class="btn-primary">Clear search</a>
                }
                else
                {
                    <h3>No records available yet.</h3>
                }
            </div>
        }
        else
        {
            <div class="books-grid">
                @foreach (var product in Model.Products)
                {
                    var shortDesc = product.Description;

                    if (!string.IsNullOrWhiteSpace(shortDesc) && shortDesc.Length > 140)
                    {
                        shortDesc = shortDesc[..140] + "...";
                    }

                    var isFavorite = Model.FavoriteProductIds.Contains(product.Id);
                    var hasDetailsPdf = !string.IsNullOrWhiteSpace(product.DescriptionPdfPath);
                    var imageSrc = !string.IsNullOrWhiteSpace(product.ImagePath)
                        ? Url.Content("~/" + product.ImagePath)
                        : Url.Content("~/images/no-cover.svg");

                    <div class="book-card">
                        <div class="book-cover-wrapper">
                            <img class="book-cover"
                                 src="@imageSrc"
                                 alt="@product.Title"
                                 onerror="this.src='/images/no-cover.svg';this.onerror=null;" />

                            <div class="book-price-badge">
                                @product.Price.ToString("0.00") RON
                            </div>
                        </div>

                        <div class="book-info">
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                @if (!string.IsNullOrWhiteSpace(product.Category?.Name))
                                {
                                    <span class="book-category">@product.Category.Name</span>
                                }

                                @if (hasDetailsPdf)
                                {
                                    <span class="badge bg-success-subtle text-success border">Details PDF</span>
                                }
                            </div>

                            <h3 class="book-title">@product.Title</h3>

                            @if (!string.IsNullOrWhiteSpace(product.Author))
                            {
                                <p class="book-author">by @product.Author</p>
                            }

                            <p class="book-desc">
                                @(string.IsNullOrWhiteSpace(shortDesc) ? "No description available." : shortDesc)
                            </p>

                            <div class="book-meta">
                                @if (!string.IsNullOrWhiteSpace(product.Supplier?.Name))
                                {
                                    <span>
                                        <i class='bx bx-store'></i>
                                        @product.Supplier.Name
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(product.Isbn))
                                {
                                    <span>
                                        <i class='bx bx-barcode'></i>
                                        ISBN: @product.Isbn
                                    </span>
                                }

                                @if (product.PublishedYear.HasValue)
                                {
                                    <span>
                                        <i class='bx bx-calendar'></i>
                                        @product.PublishedYear
                                    </span>
                                }

                                @if (product.PageCount.HasValue)
                                {
                                    <span>
                                        <i class='bx bx-file'></i>
                                        @product.PageCount pages
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="book-actions flex-column align-items-stretch gap-2">
                            <a asp-page="/Products/Details"
                                   asp-route-id="@product.Id"
                                   class="btn-details text-center">
                                Details
                            </a>

                            @if (hasDetailsPdf)
                            {
                                <a asp-page="/Products/DescriptionPdf"
                                       asp-route-id="@product.Id"
                                       class="btn btn-outline-secondary w-100">
                                    <i class='bx bx-file'></i> Open PDF
                                </a>
                            }

                            <div class="action-icons justify-content-center">
                                <form method="post"
                                      asp-page="/Favorites/Index"
                                      asp-page-handler="Add">
                                    <input type="hidden" name="productId" value="@product.Id" />

                                    <button type="submit"
                                            class="icon-btn @(isFavorite ? "active-heart" : "")"
                                            title="Add to favorites">
                                        <i class='bx @(isFavorite ? "bxs-heart" : "bx-heart")'></i>
                                    </button>
                                </form>

                                <form method="post"
                                      asp-page="/Cart/Index"
                                      asp-page-handler="Add">
                                    <input type="hidden" name="productId" value="@product.Id" />

                                    <button type="submit" class="icon-btn cart-btn" title="Add to cart">
                                        <i class='bx bx-cart-add'></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/library-autocomplete.js" asp-append-version="true"></script>
    <script src="~/js/library-autocomplete-config.js" asp-append-version="true"></script>
}